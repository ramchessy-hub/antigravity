{
  "name": "stakecruncher-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper with content protection against remote screen capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.stakecruncher.desktop",
    "productName": "StakeCruncher",
    "win": {
      "target": "portable",
      "icon": null
    },
    "files": ["main.js", "package.json"]
  }
}
